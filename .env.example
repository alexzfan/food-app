# Postgres
POSTGRES_PASSWORD=recipe
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
WEB_PORT=8000

# YouTube Data API
YOUTUBE_API_KEY=your-youtube-api-key

# ML service
ML_PORT=8001
WHISPER_MODEL_SIZE=base

# Recipe extractor backend: "local" (Ollama), "llamacpp" (local GPU llama.cpp
# server), or "hosted" (any OpenAI-compatible API, e.g. vLLM).
EXTRACTOR_BACKEND=local
# Ollama runs as a compose service by default. To use an Ollama on your host
# instead, set: OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_URL=http://ollama:11434
OLLAMA_PORT=11434
# Ollama-library tag (Gemma 4 26B-A4B, QAT, ~16GB). Pulled automatically by the
# ollama-pull service on first `docker compose up` and cached in ollama-data.
# Smaller options for weaker hardware: gemma4:e4b (9.6GB) or gemma4:e2b (7.2GB).
# Note: the hf.co/unsloth/...-GGUF references do not register on Ollama 0.30.x
# (manifest 400); use these library tags instead.
GEMMA_MODEL=gemma4:26b-a4b-it-qat

# GPU path (EXTRACTOR_BACKEND=llamacpp): llama.cpp server with MoE expert
# offload. Runs the 26B-A4B on a ~16GB GPU (attention on GPU, experts in RAM;
# needs ~32GB system RAM). Start with:
#   EXTRACTOR_BACKEND=llamacpp docker compose --profile gpu up
LLAMACPP_URL=http://llamacpp:8080/v1/chat/completions
LLAMACPP_PORT=8080
# llama.cpp loads the unsloth GGUF directly (the one that 400s in Ollama).
LLAMACPP_HF_MODEL=unsloth/gemma-4-26B-A4B-it-qat-GGUF:Q4_K_XL
LLAMACPP_CTX=8192
# How many layers' MoE experts to keep in CPU RAM:
#   99 = all experts in RAM (needs ~32GB RAM, GPU-poor case; the default)
#   0  = fully GPU-resident (when the quant ~fits VRAM)
#   8-16 = partial offload: fits a ~16GB GPU without much RAM (RAM-limited boxes)
LLAMACPP_NCMOE=99

# Hosted backend (EXTRACTOR_BACKEND=hosted): any OpenAI-compatible API (vLLM,
# a cloud LLM, etc.)
HOSTED_LLM_URL=
HOSTED_LLM_API_KEY=
HOSTED_LLM_MODEL=

# Max uploaded media duration (seconds)
MAX_DURATION_SECONDS=900
