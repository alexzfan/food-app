# ===========================================
# Recipe Finder - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# ===========================================
# JWT & Security
# ===========================================
# IMPORTANT: Generate secure random strings for production!
# You can use: openssl rand -base64 32

# JWT secret for signing tokens (must be at least 32 characters)
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters

# JWT token expiry in seconds (default: 3600 = 1 hour)
JWT_EXPIRY=3600

# ===========================================
# Supabase Keys
# ===========================================
# These are generated based on JWT_SECRET
# For local development, you can use these example keys
# For production, generate proper keys: https://supabase.com/docs/guides/self-hosting

# Anonymous key - for unauthenticated access
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Service role key - for admin access (keep secret!)
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ===========================================
# Database
# ===========================================
POSTGRES_PASSWORD=postgres

# ===========================================
# External APIs
# ===========================================
# Get your YouTube API key from: https://console.cloud.google.com/
YOUTUBE_API_KEY=your-youtube-api-key

# Get your Anthropic API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# ===========================================
# URLs
# ===========================================
# External URL for the API gateway
API_EXTERNAL_URL=http://localhost:8000

# Site URL for redirects (your frontend app)
SITE_URL=http://localhost:3000

# Additional redirect URLs for OAuth (comma-separated)
ADDITIONAL_REDIRECT_URLS=recipefinder://auth/callback

# ===========================================
# Ports (optional - defaults shown)
# ===========================================
API_PORT=3000
POSTGRES_PORT=5432
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
STUDIO_PORT=3001
INBUCKET_PORT=9000

# ===========================================
# Email Configuration
# ===========================================
# For local development, Inbucket is used (no config needed)
# For production, configure your SMTP server:

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_ADMIN_EMAIL=noreply@example.com

# ===========================================
# Authentication Options
# ===========================================
# Disable new user signups
DISABLE_SIGNUP=false

# Enable email signup
ENABLE_EMAIL_SIGNUP=true

# Auto-confirm emails (skip verification)
ENABLE_EMAIL_AUTOCONFIRM=false

# Enable anonymous users
ENABLE_ANONYMOUS_USERS=false

# ===========================================
# Google OAuth (optional)
# ===========================================
# Enable Google OAuth
ENABLE_GOOGLE_SIGNUP=false

# Get credentials from: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
