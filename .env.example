# Postgres
POSTGRES_PASSWORD=recipe
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
WEB_PORT=8000

# YouTube Data API
YOUTUBE_API_KEY=your-youtube-api-key

# ML service
ML_PORT=8001
WHISPER_MODEL_SIZE=base

# Recipe extractor backend: "llamacpp" (local GPU llama.cpp server, the
# default), "hosted" (any OpenAI-compatible API, e.g. vLLM), or "local" (an
# external Ollama-compatible server -- no longer bundled in compose; point
# OLLAMA_URL at it).
EXTRACTOR_BACKEND=llamacpp

# Local backend (EXTRACTOR_BACKEND=llamacpp): llama.cpp server with MoE expert
# offload, runs by default. Serves the 26B-A4B on a ~16GB GPU (attention on GPU,
# experts in RAM; needs ~32GB system RAM). Requires an NVIDIA GPU + the NVIDIA
# Container Toolkit. Start with: docker compose up
LLAMACPP_URL=http://llamacpp:8080/v1/chat/completions
LLAMACPP_PORT=8080
# llama.cpp loads the unsloth GGUF directly.
LLAMACPP_HF_MODEL=unsloth/gemma-4-26B-A4B-it-qat-GGUF:Q4_K_XL
LLAMACPP_CTX=8192
# How many layers' MoE experts to keep in CPU RAM:
#   99 = all experts in RAM (needs ~32GB RAM, GPU-poor case; the default)
#   0  = fully GPU-resident (when the quant ~fits VRAM)
#   8-16 = partial offload: fits a ~16GB GPU without much RAM (RAM-limited boxes)
LLAMACPP_NCMOE=99

# Hosted backend (EXTRACTOR_BACKEND=hosted): any OpenAI-compatible API (vLLM,
# a cloud LLM, etc.)
HOSTED_LLM_URL=
HOSTED_LLM_API_KEY=
HOSTED_LLM_MODEL=

# Max uploaded media duration (seconds)
MAX_DURATION_SECONDS=900
