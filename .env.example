# Postgres
POSTGRES_PASSWORD=recipe
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
WEB_PORT=8000

# YouTube Data API
YOUTUBE_API_KEY=your-youtube-api-key

# ML service
ML_PORT=8001
WHISPER_MODEL_SIZE=base

# Recipe extractor: "local" (Ollama/Gemma) or "hosted"
EXTRACTOR_BACKEND=local
# Ollama runs as a compose service by default. To use an Ollama on your host
# instead, set: OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_URL=http://ollama:11434
OLLAMA_PORT=11434
# Pulled automatically by the ollama-pull service on first `docker compose up`
# (~14GB, Q4_K_XL) and cached in the ollama-data volume.
GEMMA_MODEL=hf.co/unsloth/gemma-4-26B-A4B-it-qat-GGUF:Q4_K_XL

# Hosted fallback (used when EXTRACTOR_BACKEND=hosted)
HOSTED_LLM_URL=
HOSTED_LLM_API_KEY=
HOSTED_LLM_MODEL=

# Max uploaded media duration (seconds)
MAX_DURATION_SECONDS=900
